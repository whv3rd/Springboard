---
import Button from './Button.astro';

interface Props {
  /** Short excerpt shown above the gate. Usually the part's `teaser` frontmatter. */
  teaser?: string;
  title?: string;
}

const { teaser, title = 'This part is in the Path' } = Astro.props;
---

<section class="paywall" aria-labelledby="paywall-title">
  {teaser && <p class="paywall__teaser">{teaser}</p>}
  <div class="paywall__gate">
    <p class="eyebrow">Path members</p>
    <h2 id="paywall-title" class="paywall__title">
      {title}
    </h2>
    <p class="paywall__text">
      The step-by-step build guide, templates, prompts, MCP configs and workflows are part of the
      Path. The overview, requirements and checklist for every track stay free.
    </p>
    <div class="paywall__actions">
      <Button href="/pricing">See Path pricing</Button>
      <Button href="/score" variant="secondary">
        Take the Score
      </Button>
    </div>
  </div>
</section>

<style>
  .paywall {
    max-width: var(--width-prose);
  }

  /* The teaser is a complete pitch, not an excerpt of the body, so it shows in full. */
  .paywall__teaser {
    font-size: var(--text-md);
  }

  .paywall__gate {
    margin-top: var(--space-4);
    padding: var(--space-6);
    background: var(--color-accent-subtle);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-lg);
  }

  .paywall__title {
    font-size: var(--text-xl);
    margin-top: var(--space-2);
  }

  .paywall__text {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
  }

  .paywall__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-5);
  }
</style>
