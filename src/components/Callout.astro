---
type Kind = 'note' | 'tip' | 'warning' | 'danger';

interface Props {
  type?: Kind;
  title?: string;
}

const LABELS: Record<Kind, string> = {
  note: 'Note',
  tip: 'Tip',
  warning: 'Warning',
  danger: 'Important',
};

const { type = 'note', title } = Astro.props;
---

<aside class:list={['callout', `callout--${type}`]}>
  <p class="callout__title">{title ?? LABELS[type]}</p>
  <div class="callout__body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    padding: var(--space-4) var(--space-5);
    border-left: 4px solid var(--callout-border);
    border-radius: var(--radius-md);
    background: var(--callout-bg);
  }

  .callout--note {
    --callout-bg: var(--color-note-bg);
    --callout-border: var(--color-note-border);
  }

  .callout--tip {
    --callout-bg: var(--color-tip-bg);
    --callout-border: var(--color-tip-border);
  }

  .callout--warning {
    --callout-bg: var(--color-warning-bg);
    --callout-border: var(--color-warning-border);
  }

  .callout--danger {
    --callout-bg: var(--color-danger-bg);
    --callout-border: var(--color-danger-border);
  }

  .callout__title {
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-1);
  }

  .callout__body > :global(* + *) {
    margin-top: var(--space-2);
  }
</style>
