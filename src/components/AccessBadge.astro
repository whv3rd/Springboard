---
import type { Access } from '@/lib/path';

interface Props {
  access: Access;
}

const LABELS: Record<Access, string> = {
  free: 'Free',
  paid: 'Paid',
};

const { access } = Astro.props;
---

<span class:list={['badge', `badge--${access}`]}>{LABELS[access]}</span>

<style>
  .badge {
    display: inline-block;
    padding: 0.1em 0.6em;
    border: 1px solid var(--badge-border);
    border-radius: var(--radius-full);
    background: var(--badge-bg);
    color: var(--color-text);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-normal);
    white-space: nowrap;
  }

  .badge--free {
    --badge-bg: var(--color-accent-subtle);
    --badge-border: var(--color-accent);
  }

  .badge--paid {
    --badge-bg: var(--color-surface);
    --badge-border: var(--color-border-strong);
  }
</style>
