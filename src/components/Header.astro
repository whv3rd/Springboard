---
import Button from './Button.astro';
import { PRIMARY_NAV, isCurrent } from '@/lib/nav';

const { pathname } = Astro.url;

// The two sites share this header: the active tab is this site, the other links across.
// Swap SITE_LABEL for the domain (e.g. springspot.ai) once it is registered.
const SITE_LABEL = 'Springspot AI';
const WILLVINTON_URL = 'https://www.willvinton.com/';
---

<header class="site-header">
  <div class="container site-header__inner">
    <nav class="site-tabs" aria-label="Sites">
      <a
        href={WILLVINTON_URL}
        class="site-tab"
        data-track="nav_click"
        data-track-nav-type="site_tabs"
        data-track-link-text="willvinton.com"
      >
        <span class="site-tab__mark site-tab__mark--wv" aria-hidden="true">
          wv
        </span>
        <span class="site-tab__label">willvinton.com</span>
        <svg class="site-tab__out" viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
          <path d="M7 7h10v10M7 17 17 7"></path>
        </svg>
      </a>
      <span class="site-tabs__divider" aria-hidden="true"></span>
      <a
        href="/"
        class="site-tab site-tab--active"
        aria-current="true"
        data-track="logo_click"
        data-track-link-text="Springspot AI"
      >
        <svg class="site-tab__mark" viewBox="0 0 32 32" aria-hidden="true">
          <rect width="32" height="32" rx="7" fill="currentColor"></rect>
          <path
            d="M8 22h16M11 22l5-12 5 12"
            stroke="var(--color-bg)"
            stroke-width="2.5"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          ></path>
        </svg>
        <span class="site-tab__label">{SITE_LABEL}</span>
      </a>
    </nav>
    <nav
      class="site-header__nav"
      aria-label="Primary"
      data-track-area="nav"
      data-track-nav-type="primary"
    >
      <ul>
        {PRIMARY_NAV.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={
                isCurrent(item.href, pathname, import.meta.env.BASE_URL) ? 'page' : undefined
              }
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <Button href="/score" class="site-header__cta" data-track-cta-location="header">
      Take the Score
    </Button>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-5);
  }

  .site-tabs {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .site-tabs__divider {
    width: 1px;
    height: 1.25rem;
    background: var(--color-border);
  }

  .site-tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 4.5rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-tab:hover {
    color: var(--color-text);
  }

  .site-tab--active {
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
  }

  .site-tab--active::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px;
    height: 2px;
    background: var(--color-accent);
  }

  .site-tab__mark {
    flex: none;
    width: 1.375rem;
    height: 1.375rem;
  }

  .site-tab__mark--wv {
    display: inline-grid;
    place-items: center;
    border-radius: 5px;
    background: var(--color-text-muted);
    color: var(--color-bg);
    font-family: var(--font-serif);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .site-tab:hover .site-tab__mark--wv {
    background: var(--color-text);
  }

  .site-tab__out {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 30rem) {
    .site-header__inner :global(.site-header__cta) {
      display: none;
    }

    .site-tab:not(.site-tab--active) .site-tab__label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }

  .site-header__nav {
    order: 3;
    flex-basis: 100%;
    padding-bottom: var(--space-3);
  }

  .site-header__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-inline: calc(-1 * var(--space-3));
    padding: 0;
    list-style: none;
  }

  .site-header__nav a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-full);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__nav a:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }

  .site-header__nav a[aria-current='page'] {
    color: var(--color-text);
    background: var(--color-surface);
  }

  :global(.site-header__cta) {
    margin-left: auto;
  }

  @media (min-width: 60rem) {
    .site-header__nav {
      order: 0;
      flex-basis: auto;
      margin-left: auto;
      padding-bottom: 0;
    }

    .site-header__nav ul {
      margin-inline: 0;
    }

    :global(.site-header__cta) {
      margin-left: 0;
    }
  }
</style>
