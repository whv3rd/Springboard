---
/**
 * Homepage hero graphic: the five checkpoints wire into a spring standing on the spot.
 * Each connection adds 20 to the Score and compresses the spring; at 100 it releases
 * and launches the parcel. Pure SVG + CSS, no script. With reduced motion it holds the
 * finished state (all five connected, Score 100).
 */
import { CHECKPOINTS, LEVELS } from '@/lib/score';

const GROUND = 440;
const coil = Array.from({ length: 6 }, (_, i) => GROUND - 28 * i);
const front = coil.map((y) => `M278,${y} C278,${y + 11} 362,${y - 3} 362,${y - 14}`).join(' ');
const back = coil.map((y) => `M362,${y - 14} C362,${y - 25} 278,${y - 39} 278,${y - 28}`).join(' ');

// Checkpoints 1-3 sit on the left, 4-5 on the right; each has a wire into the spot.
const rows = [110, 195, 280, 195, 280];
const nodes = CHECKPOINTS.map((c, i) => {
  const left = i < 3;
  const y = rows[i];
  const yc = y + 20;
  return {
    n: c.number,
    name: c.name,
    y,
    yc,
    chipX: left ? 24 : 576,
    labelX: left ? 76 : 564,
    anchor: left ? 'start' : 'end',
    portX: left ? 206 : 434,
    wire: left
      ? `M206,${yc} C262,${yc} 214,${GROUND} 264,${GROUND}`
      : `M434,${yc} C378,${yc} 426,${GROUND} 376,${GROUND}`,
  };
});

// One readout per step: five checkpoints at full marks are worth 20 each.
const scores = [0, 20, 40, 60, 80, 100];
const last = LEVELS.length - 1;
---

<svg
  class="hs"
  viewBox="0 0 640 480"
  role="img"
  aria-label="Five checkpoints connect one by one to a spring standing on a target. Each connection raises the Springspot Score by 20 and compresses the spring. At 100 it releases and launches a parcel."
>
  <line class="hs__ground" x1="24" y1={GROUND} x2="616" y2={GROUND}></line>
  <g class="hs__target">
    <ellipse class="hs__ring" cx="320" cy={GROUND} rx="56" ry="9"></ellipse>
    <ellipse class="hs__ring" cx="320" cy={GROUND} rx="37" ry="6"></ellipse>
    <ellipse class="hs__bull" cx="320" cy={GROUND} rx="16" ry="2.6"></ellipse>
  </g>
  <ellipse class="hs__pulse" cx="320" cy={GROUND} rx="56" ry="9"></ellipse>

  {nodes.map((d) => (
    <g>
      <path class="hs__ghost" d={d.wire} />
      <path class={`hs__wire hs__wire--${d.n}`} d={d.wire} pathLength="1" />
      <circle class="hs__port" cx={d.portX} cy={d.yc} r="3.5" />
      <rect class="hs__chip" x={d.chipX} y={d.y} width="40" height="40" rx="2" />
      <text class="hs__num" x={d.chipX + 20} y={d.y + 25.5} text-anchor="middle">
        {d.n}
      </text>
      <text class="hs__label" x={d.labelX} y={d.y + 26} text-anchor={d.anchor}>
        {d.name}
      </text>
      <g class={`hs__on hs__on--${d.n}`}>
        <rect class="hs__chip hs__chip--on" x={d.chipX} y={d.y} width="40" height="40" rx="2" />
        <text class="hs__num hs__num--on" x={d.chipX + 20} y={d.y + 25.5} text-anchor="middle">
          {d.n}
        </text>
        <text class="hs__label hs__label--on" x={d.labelX} y={d.y + 26} text-anchor={d.anchor}>
          {d.name}
        </text>
        <circle class="hs__port hs__port--on" cx={d.portX} cy={d.yc} r="3.5" />
      </g>
    </g>
  ))}

  <g class="hs__coil">
    <path class="hs__back" d={back}></path>
    <path class="hs__front" d={front}></path>
  </g>
  <g class="hs__plate">
    <rect x="258" y="264" width="124" height="8" rx="1"></rect>
  </g>
  <g class="hs__load">
    <g class="hs__parcel">
      <rect x="304" y="232" width="32" height="32" rx="2"></rect>
      <line x1="320" y1="232" x2="320" y2="264"></line>
    </g>
  </g>

  <text class="hs__eyebrow" x="616" y="38" text-anchor="end">
    SPRINGSPOT SCORE
  </text>
  {scores.map((s) => (
    <text
      class:list={['hs__score', 'hs__step', `hs__score--${s}`, { 'hs__step--final': s === 100 }]}
      x="616"
      y="118"
      text-anchor="end"
    >
      {s}
    </text>
  ))}
  {LEVELS.map((l, i) => (
    <text
      class:list={['hs__level', 'hs__step', `hs__level--${i}`, { 'hs__step--final': i === last }]}
      x="616"
      y="152"
      text-anchor="end"
    >
      {l.name}
    </text>
  ))}
</svg>

