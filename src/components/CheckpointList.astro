---
import Card from './Card.astro';
import { CHECKPOINTS } from '@/lib/score';
import { trackHref } from '@/lib/path';

interface Props {
  headingLevel?: 2 | 3 | 4;
  /** Link each checkpoint to the Path track that builds it. */
  linkTracks?: boolean;
}

const { headingLevel = 3, linkTracks = true } = Astro.props;
---

<ol class="checkpoints">
  {CHECKPOINTS.map((cp) => (
    <li>
      <Card
        eyebrow={`Checkpoint ${cp.number}`}
        title={cp.name}
        description={cp.description}
        href={linkTracks ? trackHref(cp.track) : undefined}
        headingLevel={headingLevel}
      />
    </li>
  ))}
</ol>

<style>
  .checkpoints {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 13rem), 1fr));
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .checkpoints li {
    display: grid;
  }
</style>
