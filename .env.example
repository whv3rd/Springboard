# Copy to .env for local development. In production, set these in Cloudflare Pages:
# Settings → Environment variables, for both Production and Preview.
#
# Klaviyo, for the Score's email gate. Both values are public: the site key is Klaviyo's
# "Public API Key / Site ID" (6 characters), and the list ID is the list Score takers join.
# Leave them empty and the Score still works; it just sends nothing to Klaviyo.
PUBLIC_KLAVIYO_SITE_KEY=
PUBLIC_KLAVIYO_LIST_ID=
